# Hosted Otari only. Never commit a real key. Never prefix this with VITE_.
OTARI_API_KEY=otk_your_key_here

# Default is the US hosted gateway. EU accounts use https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# Open-weight catalog ids (models.dev canonical ids Otari routes by).
# Override with a selector copied from the Otari Models page, or with a
# routing-policy name you created in the dashboard (no ":" or "/").
OTARI_NARRATOR_MODEL=alibaba/qwen3-32b
OTARI_NARRATOR_FALLBACK=google/gemma-3-27b-it
OTARI_ATTEMPT_MODEL=meta/llama-3.3-70b-instruct
OTARI_ATTEMPT_FALLBACK=mistral/mistral-small-3.2-24b-instruct

# Optional. When set, the chat `model` is this routing-policy name instead of
# the catalog id above. Create the policy under Routing → Policies → Fallback.
OTARI_NARRATOR_POLICY=
OTARI_ATTEMPT_POLICY=

# auto: send the session id as `user`, and if Otari says it does not match the
# key, retry without it and record that this key is not a service key.
# true: require a service key (a mismatch fails the model call).
# false: never send `user`. The session id still goes in metadata.end_user.
OTARI_SERVICE_KEY=auto

# Optional budget id from a service key's end-user budget list.
# Sent as Otari-End-User-Budget only when `user` is sent.
OTARI_END_USER_BUDGET_ID=

# Request guardrail. monitor + on_unavailable monitor still completes when the
# workspace has no guardrail service, and the Otari-Guardrails header says so.
OTARI_GUARDRAIL_PROFILE=prompt-injection
OTARI_GUARDRAIL_MODE=monitor
OTARI_GUARDRAIL_ON_UNAVAILABLE=monitor

# App-side ceiling for one session id, in USD, on top of Otari's own budgets.
FIRST_BREAK_SESSION_USD=1

# Optional public https MCP server. Hosted Otari must be able to reach it.
# Leave empty unless you have completed the dashboard step in README.
OTARI_MCP_SERVER_URL=
OTARI_MCP_SERVER_NAME=first-break-hints
OTARI_MCP_ALLOWED_TOOLS=
OTARI_MCP_PURPOSE=

# Server port. The dev client proxies to this. Production `npm start` serves
# the built client and the API on this port.
PORT=43124
